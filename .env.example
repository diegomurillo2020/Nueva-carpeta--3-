# =============================================================================
# ConvoAssemble - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Cloud Project)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# -----------------------------------------------------------------------------
# Database (Prisma)
# For Supabase cloud: use the "Session Mode" pooler URL from the dashboard.
# Format: postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# For local Supabase (supabase start): postgresql://postgres:postgres@localhost:54322/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[YOUR_REF]:[YOUR_DB_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# JWT (must match your Supabase project JWT secret)
# Found in: Supabase Dashboard -> Settings -> API -> JWT Settings
# -----------------------------------------------------------------------------
JWT_SECRET=your-supabase-jwt-secret-here

# -----------------------------------------------------------------------------
# Messaging Gateways
# -----------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_random_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Telegram Bot (BotFather token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
